<Window x:Class="SmsWorkbench.PaymentBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pembayaran Batch Persetujuan"
        Width="1120"
        Height="820"
        MinWidth="920"
        MinHeight="680"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="220"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Pembayaran Batch Persetujuan" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding AccountSummary}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center"/>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Margin="0,0,7,10">
        <TextBlock Text="Metode pembayaran" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding PaymentMethodOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedMethod}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="7,0,7,10">
        <TextBlock Text="Konkurensi" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding WorkerOptions}" SelectedItem="{Binding Workers}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="7,0,7,10">
        <TextBlock Text="Retry transien" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding RetryOptions}" SelectedItem="{Binding Retries}"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Margin="7,0,0,10">
        <TextBlock Text="Jumlah Canary (0=semua)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding CanaryText, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,7,10">
        <TextBlock Text="ID Batch" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding BatchId, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="7,0,0,10">
        <TextBlock Text="Proxy Seed" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,2">
        <CheckBox Content="401 Pemulihan Otomatis (RT/Cookie/Browser/OAuth)" IsChecked="{Binding JitRefresh}" Margin="0,0,22,0"/>
        <CheckBox Content="Hanya deteksi kemampuan (Checkout + Stripe init)" IsChecked="{Binding ProbeOnly}" Margin="0,0,22,0"/>
        <CheckBox Content="Perlukan jumlah 0" IsChecked="{Binding RequireZero}" IsEnabled="{Binding RequireZeroEnabled}"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Matriks Wilayah Akun / Kelayakan Pembayaran" FontSize="13" FontWeight="SemiBold"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Tambahkan unit" Command="{Binding AddMatrixRowCommand}" MinWidth="82" Height="28" Margin="0,0,6,0"/>
          <Button Content="Hapus Unit" Command="{Binding DeleteMatrixRowCommand}" MinWidth="82" Height="28"/>
        </StackPanel>
      </Grid>
      <DataGrid Grid.Row="1"
                ItemsSource="{Binding MatrixRows}"
                SelectedItem="{Binding SelectedMatrixRow}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                RowHeight="34">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="120"/>
          <DataGridTextColumn Header="Wilayah pendaftaran" Binding="{Binding RegistrationCountry}" Width="62"/>
          <DataGridTextColumn Header="Checkout" Binding="{Binding CheckoutCountry}" Width="78"/>
          <DataGridTextColumn Header="Promotion" Binding="{Binding PromotionCountry}" Width="82"/>
          <DataGridTextColumn Header="Provider" Binding="{Binding ProviderCountry}" Width="76"/>
          <DataGridTextColumn Header="Approve" Binding="{Binding ApproveCountry}" Width="72"/>
          <DataGridTextColumn Header="Redirect" Binding="{Binding RedirectCountry}" Width="72"/>
          <DataGridTextColumn Header="Strategi" Binding="{Binding Strategy}" Width="*"/>
          <DataGridTextColumn Header="Sampel" Binding="{Binding SampleSize}" Width="56"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Grid Grid.Row="3" Margin="0,0,0,12">
      <DataGrid x:Name="ResultsGrid"
                ItemsSource="{Binding Results}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                RowHeight="42"
                Margin="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Akun" Binding="{Binding AccountRef}" Width="135"/>
          <DataGridTextColumn Header="Matriks" Binding="{Binding MatrixCell}" Width="115"/>
          <DataGridTextColumn Header="AT" Binding="{Binding AuthStatus}" Width="68"/>
          <DataGridTextColumn Header="JIT" Binding="{Binding RefreshStatus}" Width="66"/>
          <DataGridTextColumn Header="Kelayakan" Binding="{Binding Eligibility}" Width="66"/>
          <DataGridTextColumn Header="Status akhir" Binding="{Binding TerminalState}" Width="82"/>
          <DataGridTextColumn Header="Tahap Error" Binding="{Binding ErrorStage}" Width="96"/>
          <DataGridTemplateColumn Header="Tautan pembayaran / Kode QR" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid Margin="6,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ResultKind}"
                             Foreground="{DynamicResource TextSub}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding ResultDisplay}"
                             ToolTip="{Binding ResultDisplay}"
                             FontFamily="Consolas"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="2"
                          Width="30"
                          Height="28"
                          Padding="0"
                          Margin="8,0,0,0"
                          Command="{Binding DataContext.CopyResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding HasCopyableResult}"
                          ToolTip="{Binding CopyToolTip}">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Jumlah kali" Binding="{Binding Attempts}" Width="56"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Buka laporan" Command="{Binding OpenReportCommand}" MinWidth="84" Margin="0,0,8,0"/>
        <Button Content="Batal" Command="{Binding RunCancelCommand}" MinWidth="72" Margin="0,0,8,0"/>
        <Button Content="Mulai Eksekusi" Command="{Binding RunCommand}" MinWidth="96" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
        <Button Content="Tutup" MinWidth="72" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
